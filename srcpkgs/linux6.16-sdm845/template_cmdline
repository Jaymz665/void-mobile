# Template file for 'linux6.16-sdm845'
pkgname=linux6.16-sdm845
version=6.16.7
revision=19
_tag="sdm845-6.16.7-r0"
short_desc="Linux kernel and modules (${version%.*} series for OnePlus 6t)"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-2.0-only"
homepage="https://www.kernel.org"
distfiles="https://gitlab.com/sdm845-mainline/linux/-/archive/${_tag}/linux-${_tag}.tar.gz"
checksum="a9ce2fde510261d38f809e543abe4e90fbfd3a4e7a3eee3ea4a84b68d2d7d811"

python_version=3
archs="aarch64*"

nodebug=yes
nostrip=yes
noverifyrdeps=yes
noshlibprovides=yes
preserve=yes

hostmakedepends="tar xz bc elfutils-devel flex findutils gmp-devel kmod libmpc-devel
 pkg-config openssl-devel perl uboot-mkimage cpio pahole python3 zstd
 clang lld llvm"

_localversion="sdm845"
_kernver="${version}-${_localversion}"

# Триггеры для хуков (сами хуки теперь в отдельном пакете)
triggers="kernel-hooks"
kernel_hooks_version="${_kernver}"

mutable_files="
 /usr/lib/modules/${_kernver}/modules.builtin.bin
 /usr/lib/modules/${_kernver}/modules.builtin.alias.bin
 /usr/lib/modules/${_kernver}/modules.softdep
 /usr/lib/modules/${_kernver}/modules.dep
 /usr/lib/modules/${_kernver}/modules.dep.bin
 /usr/lib/modules/${_kernver}/modules.symbols
 /usr/lib/modules/${_kernver}/modules.symbols.bin
 /usr/lib/modules/${_kernver}/modules.alias
 /usr/lib/modules/${_kernver}/modules.alias.bin
 /usr/lib/modules/${_kernver}/modules.devname"

export KBUILD_BUILD_TIMESTAMP=$(LC_ALL=C date -ud @${SOURCE_DATE_EPOCH:-0})
export KBUILD_BUILD_USER=voidlinux
export KBUILD_BUILD_HOST=voidlinux

if [ "$CROSS_BUILD" ]; then
	_cross="CROSS_COMPILE=${XBPS_CROSS_TRIPLET}-"
fi

do_configure() {
    local arch
    arch=arm64
    
    # Начинаем с базового defconfig
    msg_normal "Starting with defconfig\n"
    make ARCH=$arch ${_cross} LLVM=1 defconfig
    
    # Применяем конфиги из postmarketOS последовательно
    msg_normal "Applying postmarketOS configuration fragments...\n"
    
    # Сначала применяем sdm845.config (основной конфиг для SoC)
    if [ -f "${FILESDIR}/sdm845.config" ]; then
        msg_normal "Applying sdm845.config\n"
        ${XBPS_COMMONDIR}/environment/configure/scripts/merge_config.sh \
            -m -r -O ${wrksrc} \
            ${wrksrc}/.config \
            ${FILESDIR}/sdm845.config
    fi
    
    # Применяем pmos.config (общие настройки postmarketOS)
    if [ -f "${FILESDIR}/pmos.config" ]; then
        msg_normal "Applying pmos.config\n"
        ${XBPS_COMMONDIR}/environment/configure/scripts/merge_config.sh \
            -m -r -O ${wrksrc} \
            ${wrksrc}/.config \
            ${FILESDIR}/pmos.config
    fi
    
    # Применяем misc.config (разные полезные настройки)
    if [ -f "${FILESDIR}/misc.config" ]; then
        msg_normal "Applying misc.config\n"
        ${XBPS_COMMONDIR}/environment/configure/scripts/merge_config.sh \
            -m -r -O ${wrksrc} \
            ${wrksrc}/.config \
            ${FILESDIR}/misc.config
    fi
    
    # Применяем основной конфиг для устройства
    if [ -f "${FILESDIR}/config-postmarketos-qcom-sdm845.aarch64" ]; then
        msg_normal "Applying config-postmarketos-qcom-sdm845.aarch64\n"
        ${XBPS_COMMONDIR}/environment/configure/scripts/merge_config.sh \
            -m -r -O ${wrksrc} \
            ${wrksrc}/.config \
            ${FILESDIR}/config-postmarketos-qcom-sdm845.aarch64
    fi
    
    # Применяем void.config если он существует (ваши дополнительные настройки)
    if [ -f "${FILESDIR}/void.config" ]; then
        msg_normal "Applying Void Linux specific configuration\n"
        ${XBPS_COMMONDIR}/environment/configure/scripts/merge_config.sh \
            -m -r -O ${wrksrc} \
            ${wrksrc}/.config \
            ${FILESDIR}/void.config
    fi
    
    # ВАЖНО: Принудительно применяем хардкодный cmdline ПОСЛЕ всех конфигов
    msg_normal "FORCING hardcoded CMDLINE for OnePlus 6t\n"
    
    # Удаляем все существующие настройки CMDLINE
    sed -i '/^CONFIG_CMDLINE=/d' .config
    sed -i '/^# CONFIG_CMDLINE is not set/d' .config
    sed -i '/^CONFIG_CMDLINE_FORCE=/d' .config
    sed -i '/^# CONFIG_CMDLINE_FORCE is not set/d' .config
    
    # Добавляем наш хардкодный cmdline
    cat >> .config << EOF
# OnePlus 6t hardcoded cmdline (applied by template)
CONFIG_CMDLINE="root=PARTLABEL=userdata rootfstype=ext4 rw console=ttyMSM0,115200 noquiet console=tty0 loglevel=7 keep_bootcon"
CONFIG_CMDLINE_FORCE=y
EOF
    
    # Обновляем конфигурацию для применения изменений
    msg_normal "Running olddefconfig to finalize configuration\n"
    make ARCH=$arch ${_cross} LLVM=1 olddefconfig
    
    # ПРОВЕРКА: Убеждаемся что наш cmdline применился
    msg_normal "VERIFYING CMDLINE CONFIGURATION:\n"
    if grep -q "CONFIG_CMDLINE=\"root=PARTLABEL=userdata" .config; then
        msg_normal "✅ SUCCESS: Hardcoded CMDLINE is set\n"
        grep "CONFIG_CMDLINE" .config | head -1
    else
        msg_error "❌ FAILED: Hardcoded CMDLINE is NOT set!\n"
        msg_error "Current CMDLINE settings:\n"
        grep "CONFIG_CMDLINE" .config || echo "No CMDLINE found!"
        exit 1
    fi
    
    # Дополнительная проверка CONFIG_CMDLINE_FORCE
    if grep -q "CONFIG_CMDLINE_FORCE=y" .config; then
        msg_normal "✅ SUCCESS: CMDLINE_FORCE is enabled\n"
    else
        msg_warning "⚠️  WARNING: CMDLINE_FORCE is not enabled\n"
    fi
    
    # Показываем несколько важных опций для информации
    msg_normal "Other important options:\n"
    grep "CONFIG_VIDEO_SA3103" .config || echo "VIDEO_SA3103: not set"
    grep "CONFIG_LOCALVERSION" .config || echo "LOCALVERSION: not set"
}

do_build() {
	local arch _args
	arch=arm64

	export LDFLAGS=
	
	msg_normal "Building kernel preparations...\n"
	make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 prepare
	
	_args="Image modules dtbs"
	msg_normal "Building kernel Image, modules and dtbs...\n"
	make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 ${_args}
	
	if grep -q '^CONFIG_EFI_ZBOOT=y' .config; then
		msg_normal "Building EFI zboot image...\n"
		make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 vmlinuz.efi
	fi
}

do_install() {
	local arch _args hdrdest dtb_dest
	arch=arm64

	msg_normal "Installing kernel modules...\n"
	
	# Временно отключаем depmod скрипт во время установки модулей
	sed -i '2iexit 0' scripts/depmod.sh
	
	vmkdir usr/lib
	ln -s usr/lib/ ${DESTDIR}

	# Устанавливаем модули
	make ${makejobs} ARCH=${arch} LLVM=1 INSTALL_MOD_PATH=${DESTDIR} ${_cross} \
		INSTALL_MOD_STRIP=1 modules_install

	# Устанавливаем ядро и сопутствующие файлы
	msg_normal "Installing kernel image and related files...\n"
	vinstall .config 644 boot/config-${_kernver}
	vinstall System.map 644 boot/System.map-${_kernver}
	vinstall arch/arm64/boot/Image 644 boot/vmlinux-${_kernver}
	
	# Создаём сжатый образ если нужно
	if [ -e "arch/arm64/boot/Image.gz" ]; then
		vinstall arch/arm64/boot/Image.gz 644 boot/vmlinux-${_kernver}.gz
	else
		gzip -c -k -f arch/arm64/boot/Image > ${DESTDIR}/boot/vmlinux-${_kernver}.gz
	fi
	
	# EFI-ядро если включено
	if [ -e "arch/arm64/boot/vmlinuz.efi" ]; then
		msg_normal "Installing EFI kernel...\n"
		vinstall arch/arm64/boot/vmlinuz.efi 644 boot/vmlinux-${_kernver}.efi
		
		# Копируем в стандартное место для EFI загрузки
		mkdir -p ${DESTDIR}/boot/efi/EFI/BOOT
		cp arch/arm64/boot/vmlinuz.efi ${DESTDIR}/boot/efi/EFI/BOOT/BOOTAA64.EFI
		chmod 644 ${DESTDIR}/boot/efi/EFI/BOOT/BOOTAA64.EFI
		msg_normal "Created fallback EFI bootloader at boot/efi/EFI/BOOT/BOOTAA64.EFI\n"
	fi

	# Устанавливаем Device Tree Blobs
	msg_normal "Installing Device Tree Blobs...\n"
	dtb_dest=${DESTDIR}/boot/dtbs/dtbs-${_kernver}
	mkdir -p ${dtb_dest}
	
	make ${makejobs} ARCH=${arch} LLVM=1 INSTALL_DTBS_PATH=${dtb_dest} ${_cross} dtbs_install
	
	# Проверяем наличие dtb для OnePlus 6t и создаём симлинк если нужно
	if [ ! -f "${dtb_dest}/qcom/sdm845-oneplus-fajita.dtb" ]; then
		msg_warning "sdm845-oneplus-fajita.dtb not found, checking alternatives...\n"
		for dtb in ${dtb_dest}/qcom/sdm845-*.dtb; do
			if [ -f "$dtb" ]; then
				ln -sf $(basename "$dtb") ${dtb_dest}/qcom/sdm845-oneplus-fajita.dtb 2>/dev/null || true
				msg_normal "Created symlink from $(basename "$dtb") to sdm845-oneplus-fajita.dtb\n"
				break
			fi
		done
	else
		msg_normal "✅ Found sdm845-oneplus-fajita.dtb\n"
	fi

	# Устанавливаем заголовки ядра
	msg_normal "Installing kernel headers...\n"
	hdrdest=${DESTDIR}/usr/src/kernel-headers-${_kernver}
	vmkdir usr
	
	# Базовая установка заголовков
	make ARCH=${arch} ${_cross} LLVM=1 headers_install INSTALL_HDR_PATH=${hdrdest}/usr
	
	# Создаём структуру для сборки модулей
	cd ${DESTDIR}/usr/lib/modules/${_kernver}
	rm -f source build
	ln -sf ../../../src/kernel-headers-${_kernver} build
	
	# Копируем необходимые файлы для сборки модулей
	cd ${wrksrc}
	install -Dm644 Makefile ${hdrdest}/Makefile
	install -Dm644 Kbuild ${hdrdest}/Kbuild
	install -Dm644 .config ${hdrdest}/.config
	cp -a scripts ${hdrdest}/
	
	# Удаляем объектные файлы из скриптов при кросс-сборке
	if [ "$CROSS_BUILD" ]; then
		find ${hdrdest}/scripts -name '*.o' -delete
	fi

	# Устанавливаем vmlinux для отладки
	install -Dm644 vmlinux ${DESTDIR}/usr/lib/debug/boot/vmlinux-${_kernver}

	# Восстанавливаем оригинальный depmod.sh и запускаем depmod правильно
	msg_normal "Running depmod...\n"
	rm -f scripts/depmod.sh
	# Возвращаем оригинал из исходников если нужно
	git checkout scripts/depmod.sh 2>/dev/null || true
	
	depmod -b ${DESTDIR}/usr -F System.map ${_kernver}
	rm -f ${DESTDIR}/lib
	
	# Сохраняем информацию о версии ядра
	mkdir -p ${DESTDIR}/usr/share/kernel/${pkgname}
	install -Dm644 include/config/kernel.release \
		${DESTDIR}/usr/share/kernel/${pkgname}/kernel.release
	
	msg_normal "==================================================\n"
	msg_normal "Kernel ${_kernver} installed successfully\n"
	msg_normal "CMDLINE used: $(grep "CONFIG_CMDLINE=" .config | cut -d'"' -f2)\n"
	msg_normal "==================================================\n"
}
