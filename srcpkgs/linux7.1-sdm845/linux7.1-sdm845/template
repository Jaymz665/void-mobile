# Template file for 'linux7.1-sdm845'
pkgname=linux7.1-sdm845
version=7.1.0
revision=1
_tag="sdm845-7.1-rc1-r0"
short_desc="Linux kernel and modules (${version%.*} series for OnePlus 6t)"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-2.0-only"
homepage="https://www.kernel.org"
distfiles="https://gitlab.com/sdm845-mainline/linux/-/archive/${_tag}/linux-${_tag}.tar.gz"
checksum=4389f4ae6f5b80174a4b2d2da93ab5afc1d3922db215ebabf7c01436494eb9f2

python_version=3
archs="aarch64*"

nodebug=yes
nostrip=yes
noverifyrdeps=yes
noshlibprovides=yes
preserve=yes

# Отключаем хук, который мешает кросс-сборке ядра
nohooks="fixup-gir-path"

hostmakedepends="tar xz bc elfutils-devel flex findutils gmp-devel kmod libmpc-devel
 pkg-config openssl-devel perl uboot-mkimage cpio pahole python3 zstd
 clang lld llvm rsync"

_localversion="sdm845"
_kernver="${version}-${_localversion}"

triggers="kernel-hooks"
kernel_hooks_version="${_kernver}"

mutable_files="
 /usr/lib/modules/${_kernver}/modules.builtin.bin
 /usr/lib/modules/${_kernver}/modules.builtin.alias.bin
 /usr/lib/modules/${_kernver}/modules.softdep
 /usr/lib/modules/${_kernver}/modules.dep
 /usr/lib/modules/${_kernver}/modules.dep.bin
 /usr/lib/modules/${_kernver}/modules.symbols
 /usr/lib/modules/${_kernver}/modules.symbols.bin
 /usr/lib/modules/${_kernver}/modules.alias
 /usr/lib/modules/${_kernver}/modules.alias.bin
 /usr/lib/modules/${_kernver}/modules.devname"

export KBUILD_BUILD_TIMESTAMP=$(LC_ALL=C date -ud @${SOURCE_DATE_EPOCH:-0})
export KBUILD_BUILD_USER=voidlinux
export KBUILD_BUILD_HOST=voidlinux

if [ "$CROSS_BUILD" ]; then
	_cross="CROSS_COMPILE=${XBPS_CROSS_TRIPLET}-"
fi

# Функция для применения конфиг-фрагментов (из postmarketOS)
apply_kernel_config() {
    local config_file="$1"
    local description="$2"

    if [ -f "${config_file}" ]; then
        msg_normal "Applying ${description}\n"
        ./scripts/kconfig/merge_config.sh -m -r -O ${wrksrc} \
            ${wrksrc}/.config \
            "${config_file}"
    else
        msg_warning "Config file not found: ${config_file}\n"
    fi
}

do_configure() {
    local arch=arm64

    # Начинаем с defconfig
    msg_normal "Starting with defconfig\n"
    make ARCH=$arch ${_cross} LLVM=1 defconfig

    # Применяем основные конфиги
    apply_kernel_config "${FILESDIR}/sdm845.config" "sdm845.config"
    apply_kernel_config "${FILESDIR}/pmos.config" "pmos.config"
    apply_kernel_config "${FILESDIR}/misc.config" "misc.config"
    apply_kernel_config "${FILESDIR}/config-postmarketos-qcom-sdm845.aarch64" "config-postmarketos-qcom-sdm845.aarch64"

    # ВАЖНО: void.config с ВАШЕЙ кастомной CMDLINE применяется ПОСЛЕДНИМ
    if [ -f "${FILESDIR}/void.config" ]; then
        apply_kernel_config "${FILESDIR}/void.config" "Void Linux specific configuration"
    else
        msg_error "void.config not found! This file is required for OnePlus 6t build.\n"
        exit 1
    fi

    # Финализируем конфигурацию
    msg_normal "Running olddefconfig to finalize configuration\n"
    make ARCH=$arch ${_cross} LLVM=1 olddefconfig

    # Проверки
    msg_normal "VERIFYING CMDLINE CONFIGURATION:\n"
    if grep -q "CONFIG_CMDLINE=" .config; then
        msg_normal "✅ SUCCESS: CMDLINE is set\n"
        msg_normal "CMDLINE: $(grep "CONFIG_CMDLINE=" .config | head -1 | cut -d'"' -f2)\n"
    else
        msg_error "❌ FAILED: CMDLINE is NOT set in void.config!\n"
        exit 1
    fi

    if grep -q "CONFIG_CMDLINE_FORCE=y" .config; then
        msg_normal "✅ SUCCESS: CMDLINE_FORCE is enabled\n"
    else
        msg_warning "⚠️  WARNING: CMDLINE_FORCE is not enabled\n"
    fi
}

do_build() {
    local arch=arm64
    export LDFLAGS=

    msg_normal "Building kernel preparations...\n"
    make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 prepare

    msg_normal "Building kernel Image, modules and dtbs...\n"
    make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 Image modules dtbs

    if grep -q '^CONFIG_EFI_ZBOOT=y' .config; then
        msg_normal "Building EFI zboot image...\n"
        make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 vmlinuz.efi
    fi
}

do_install() {
    local arch hdrdest dtb_dest
    arch=arm64

    msg_normal "Installing kernel modules...\n"

    # Создаём симлинк lib -> usr/lib (требование Void)
    ln -sf usr/lib "${DESTDIR}/lib"

	make ${makejobs} ARCH=${arch} LLVM=1 ${_cross} \
	INSTALL_MOD_PATH="${DESTDIR}" \
	INSTALL_MOD_STRIP=1 \
	DEPMOD=/bin/true \
	modules_install

    # Устанавливаем ядро и сопутствующие файлы
    msg_normal "Installing kernel image and related files...\n"
    vinstall .config 644 boot config-${_kernver}
    vinstall System.map 644 boot System.map-${_kernver}
    vinstall arch/arm64/boot/Image 644 boot vmlinux-${_kernver}

    # Сжатый образ (для boot.img совместимости)
    if [ -e "arch/arm64/boot/Image.gz" ]; then
        vinstall arch/arm64/boot/Image.gz 644 boot vmlinux-${_kernver}.gz
    else
        gzip -c -k -f arch/arm64/boot/Image > "${DESTDIR}/boot/vmlinux-${_kernver}.gz"
        chmod 644 "${DESTDIR}/boot/vmlinux-${_kernver}.gz"
    fi

    # EFI-ядро, если включено
    if [ -e "arch/arm64/boot/vmlinuz.efi" ]; then
        msg_normal "Installing EFI kernel...\n"
        vinstall arch/arm64/boot/vmlinuz.efi 644 boot vmlinux-${_kernver}.efi

        mkdir -p "${DESTDIR}/boot/efi/EFI/BOOT"
        cp arch/arm64/boot/vmlinuz.efi "${DESTDIR}/boot/efi/EFI/BOOT/BOOTAA64.EFI"
        chmod 644 "${DESTDIR}/boot/efi/EFI/BOOT/BOOTAA64.EFI"
        msg_normal "Created fallback EFI bootloader at boot/efi/EFI/BOOT/BOOTAA64.EFI\n"
    fi

    # Device Tree Blobs (аналогично postmarketOS)
    msg_normal "Installing Device Tree Blobs...\n"
    dtb_dest="${DESTDIR}/boot/dtbs-tmp"
    mkdir -p "${dtb_dest}"

    make ${makejobs} ARCH=${arch} LLVM=1 INSTALL_DTBS_PATH="${dtb_dest}" ${_cross} dtbs_install

    # Оставляем только нужные DTB (sdm845)
    mkdir -p "${DESTDIR}/boot/dtbs/qcom"
    cp -r "${dtb_dest}/qcom/sdm8"* "${DESTDIR}/boot/dtbs/qcom/" 2>/dev/null || true
    rm -rf "${dtb_dest}"

    # Проверяем fajita
    if [ ! -f "${DESTDIR}/boot/dtbs/qcom/sdm845-oneplus-fajita.dtb" ]; then
        msg_warning "sdm845-oneplus-fajita.dtb not found, checking alternatives...\n"
        for dtb in "${DESTDIR}/boot/dtbs/qcom"/sdm845-*.dtb; do
            if [ -f "$dtb" ]; then
                ln -sf "$(basename "$dtb")" "${DESTDIR}/boot/dtbs/qcom/sdm845-oneplus-fajita.dtb"
                msg_normal "Created symlink: $(basename "$dtb") -> sdm845-oneplus-fajita.dtb\n"
                break
            fi
        done
    else
        msg_normal "✅ Found sdm845-oneplus-fajita.dtb\n"
    fi

    # Заголовки ядра
    msg_normal "Installing kernel headers...\n"
    hdrdest="${DESTDIR}/usr/src/kernel-headers-${_kernver}"
    vmkdir usr

    make ARCH=${arch} ${_cross} LLVM=1 headers_install INSTALL_HDR_PATH="${hdrdest}/usr"

    mkdir -p "${DESTDIR}/usr/lib/modules/${_kernver}"
    ln -sf "../../../src/kernel-headers-${_kernver}" "${DESTDIR}/usr/lib/modules/${_kernver}/build"

    install -Dm644 Makefile "${hdrdest}/Makefile"
    install -Dm644 Kbuild "${hdrdest}/Kbuild"
    install -Dm644 .config "${hdrdest}/.config"
    cp -a scripts "${hdrdest}/"

    if [ "$CROSS_BUILD" ]; then
        find "${hdrdest}/scripts" -name '*.o' -delete
    fi

    # Отладочный vmlinux
    install -Dm644 vmlinux "${DESTDIR}/usr/lib/debug/boot/vmlinux-${_kernver}"

    # Запускаем depmod вручную
    msg_normal "Running depmod...\n"
    depmod -b "${DESTDIR}/usr" -F System.map "${_kernver}"
    rm -f "${DESTDIR}/lib"

    # Сохраняем версию
    mkdir -p "${DESTDIR}/usr/share/kernel/${pkgname}"
    install -Dm644 include/config/kernel.release \
        "${DESTDIR}/usr/share/kernel/${pkgname}/kernel.release"

    msg_normal "==================================================\n"
    msg_normal "Kernel ${_kernver} installed successfully\n"
    if grep -q "CONFIG_CMDLINE=" .config; then
        msg_normal "CMDLINE: $(grep "CONFIG_CMDLINE=" .config | head -1 | cut -d'"' -f2)\n"
    fi
    msg_normal "==================================================\n"
}
