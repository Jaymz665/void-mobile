# Template file for 'firmware-oneplus-sdm845'
pkgname=firmware-oneplus-sdm845
version=13
revision=1
wrksrc="firmware-oneplus-sdm845-${commit}"
depends="linux-firmware-qualcomm linux-firmware-network"
short_desc="Firmware for OnePlus 6 / 6T"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="proprietary"
homepage="https://gitlab.com/sdm845-mainline/firmware-oneplus-sdm845"
commit="3e31a0c3e5a061645c09f805387b49fa9d35acbf"
distfiles="https://gitlab.com/sdm845-mainline/firmware-oneplus-sdm845/-/archive/${commit}/firmware-oneplus-sdm845-${commit}.tar.gz"
checksum=684f5a2c296ab708be3768e1852749c8bc8c9d313f47397de5b22d709f3e73cc
archs="aarch64"
nostrip=1
ignore_elf_dirs="/usr/share/qcom"
noshlibprovides=yes
noverifyrdeps=yes

do_install() {
    # 1. Основные файлы прошивки (firmware.files)
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        src="${line#./}"

        if [ ! -f "${wrksrc}/${src}" ]; then
            msg_warn "file not found: ${src}"
            continue
        fi

        case "$src" in
            lib/firmware/qcom/sdm845/OnePlus/enchilada/*)
                file_name="${src##*/}"
                dest="usr/lib/firmware/qcom/sdm845/oneplus6/${file_name}"
                vinstall "${wrksrc}/${src}" 0644 "$(dirname "$dest")"
                ;;
            lib/firmware/qca/OnePlus/enchilada/*)
                file_name="${src##*/}"
                dest="usr/lib/firmware/qca/oneplus6/${file_name}"
                vinstall "${wrksrc}/${src}" 0644 "$(dirname "$dest")"
                ;;
            lib/firmware/postmarketos/*)
                rel_path="${src#lib/firmware/postmarketos/}"
                dest="usr/lib/firmware/updates/${rel_path}"
                vinstall "${wrksrc}/${src}" 0644 "$(dirname "$dest")"
                ;;
            *)
                msg_warn "unexpected path in firmware.files: ${src}"
                ;;
        esac
    done < "${FILESDIR}/firmware.files"

    # 2. Сенсорные файлы (sensor.files)
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        src="${line#./}"

        if [ ! -f "${wrksrc}/${src}" ]; then
            msg_warn "sensor file not found: ${src}"
            continue
        fi

        dest="${src}"
        case "$dest" in
            usr/*) ;;
            *) dest="usr/${dest}" ;;
        esac
        vinstall "${wrksrc}/${src}" 0644 "$(dirname "$dest")"
    done < "${FILESDIR}/sensor.files"

    # 3. Создание симлинков для qcom (камеры, DSP и т.д.)
    if [ -d "${DESTDIR}/usr/lib/firmware/qcom/sdm845/oneplus6" ]; then
        mkdir -p "${DESTDIR}/usr/lib/firmware/qcom/sdm845/OnePlus"
        (
            cd "${DESTDIR}/usr/lib/firmware/qcom/sdm845/OnePlus"
            ln -sf ../oneplus6 enchilada
            ln -sf ../oneplus6 fajita
        )
    fi

    # 4. Создание симлинков для qca (Bluetooth) — важно для совместимости с ядром 7.1+
    if [ -d "${DESTDIR}/usr/lib/firmware/qca/oneplus6" ]; then
        mkdir -p "${DESTDIR}/usr/lib/firmware/qca/OnePlus"
        (
            cd "${DESTDIR}/usr/lib/firmware/qca/OnePlus"
            ln -sf ../oneplus6 enchilada
            ln -sf ../oneplus6 fajita
        )
    fi

    # 5. Симлинки для общих данных (если необходимо)
    if [ -d "${DESTDIR}/usr/share/qcom/sdm845/OnePlus/oneplus6" ]; then
        mkdir -p "${DESTDIR}/usr/share/qcom/sdm845/OnePlus"
        (
            cd "${DESTDIR}/usr/share/qcom/sdm845/OnePlus"
            ln -sf oneplus6 enchilada
            ln -sf oneplus6 fajita
        )
    fi
}

# Правильное определение хука для отключения обработки GIR-файлов (предотвращает ошибку кросс-компиляции)
hook_pre_install_98_fixup_gir_path() {
    msg_normal "Skipping hook 98-fixup-gir-path for this package."
}
