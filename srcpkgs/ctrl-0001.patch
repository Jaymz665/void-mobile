+            string? active_focus = null;
+            string? active_exp = null;
+        }
         foreach (var focus in focus_devs) {
             message ("Found focus at %s (%d - %d)", focus.path, focus.min, focus.max);
         }
@@ -102,4 +168,5 @@ namespace Cameractrl.V4L2 {
