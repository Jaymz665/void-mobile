@@ -87,6 +88,61 @@ namespace Cameractrl.V4L2 {
             }
             return output;
         }
+
+        public static string? find_device_by_process (string procname) {
+            var dir = Dir.open ("/proc");
+            if (dir == null) { warning ("/proc not accessible"); return null; }
+            string? entry;
+            while ((entry = dir.read_name ()) != null) {
+                if (entry == "." || entry == "..") continue;
+                bool is_pid = true;
+                foreach (char c in entry) if (c < '0' || c > '9') { is_pid = false; break; }
+                if (!is_pid) continue;
+                string exe_path = @"/proc/$entry/exe";
+                string target_path;
+                if (FileUtils.read_link (exe_path, out target_path) == 0 && target_path.has_suffix (procname)) {
+                    string fd_dir = @"/proc/$entry/fd";
+                    var fd_d = Dir.open (fd_dir);
+                    if (fd_d == null) continue;
+                    string? fd_entry;
+                    while ((fd_entry = fd_d.read_name ()) != null) {
+                        string link = @"/proc/$entry/fd/$fd_entry";
+                        string dev_path;
+                        if (FileUtils.read_link (link, out dev_path) == 0 && dev_path.has_prefix ("/dev/video")) {
+                            return dev_path;
+                        }
+                    }
+                }
+            }
+            return null;
+        }
+
+        private const uint32 V4L2_CID_AUTO_FOCUS_START = 0x009a090c;
+        private const uint32 V4L2_CID_AUTO_FOCUS_STOP = 0x009a090d;
+        private const uint32 V4L2_CID_EXPOSURE_AUTO = 0x009a0901;
+
+        public void trigger_autofocus () {
+            if (fd != -1) {
+                try {
+                    var ctrl = V4l2.Control () { id = V4L2_CID_AUTO_FOCUS_START, value = 1 };
+                    set_ctrl (fd, ctrl);
+                    debug ("Autofocus triggered");
+                } catch (V4l2Error e) {
+                    warning ("Autofocus not supported: %s", e.message);
+                }
+            }
+        }
+
+        public void set_auto_exposure (bool enable) {
+            if (fd != -1) {
+                try {
+                    var ctrl = get_ctrl (fd, V4L2_CID_EXPOSURE_AUTO);
+                    ctrl.value = enable ? 1 : 3;
+                    set_ctrl (fd, ctrl);
+                    debug ("Auto exposure set to %s", enable.to_string ());
+                } catch (V4l2Error e) { warning ("Auto exposure not supported: %s", e.message); }
+            }
+        }
     }
 
     Control[] focus_devs;
@@ -94,7 +150,17 @@ namespace Cameractrl.V4L2 {
 
     void init () {
         focus_devs = Control.get_all_available_controls (CameraClassControlIds.FOCUS_ABSOLUTE);
+        var active = Control.find_device_by_process ("gnome-snapshot");
         exposure_devs = Control.get_all_available_controls (ISPClassControlIds.DIGITAL_GAIN);
+        if (active != null) {
