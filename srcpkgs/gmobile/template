# Template file for 'gmobile'
pkgname=gmobile
version=0.6.0
revision=1
build_style=meson
configure_args="-Dexamples=false -Dtests=false -Dintrospection=false -Dvapi=false -Dgtk_doc=false -Dman=false -Dhwdb=false"
hostmakedepends="meson pkg-config glib-devel gettext"
makedepends="glib-devel json-glib-devel"
short_desc="Mobile device library for Librem 5 and Phosh"
maintainer="Jaymz665"
license="LGPL-2.1-or-later"
homepage="https://gitlab.gnome.org/World/Phosh/gmobile"
distfiles="https://gitlab.gnome.org/World/Phosh/gmobile/-/archive/v${version}/gmobile-v${version}.tar.gz"
checksum=a322b08c5eaa68f780434300b1cdbe185435221044afd821859a4c169b52175c

gmobile_package() {
	short_desc+=" - shared library"
	pkg_install() {
		# Устанавливаем shared library
		vmove "usr/lib/*.so.*"
	}
}

gmobile-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"  # симлинк для разработки
	}
}
