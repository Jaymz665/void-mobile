# Template file for 'libmegapixels'
pkgname=libmegapixels
version=0.2.3
revision=1
wrksrc="${pkgname}-${version}"
build_style=meson
hostmakedepends="pkg-config meson"
makedepends="libconfig-devel"
short_desc="Device abstraction for the Megapixels application"
maintainer="Jaymz665 <your-email@example.com>"
license="GPL-3.0-or-later"
homepage="https://libme.gapixels.me"
distfiles="https://gitlab.com/megapixels-org/libmegapixels/-/archive/${version}/libmegapixels-${version}.tar.gz"
checksum=cbfbb4f137ac0e5f402841f875bc07ff8970d98ae0d1bb55fc0976c02b9a4305
archs="aarch64 armv7l* x86_64 i686"

libmegapixels-devel_package() {
    short_desc+=" - development files"
    depends="${sourcepkg}>=${version}_${revision}"
    pkg_install() {
        vmove usr/include
        vmove usr/lib/pkgconfig
        vmove "usr/lib/*.so"
    }
}

post_install() {
    # Проверяем наличие разных вариантов лицензионных файлов
    if [ -f "${wrksrc}/COPYING" ]; then
        vlicense COPYING
    elif [ -f "${wrksrc}/LICENSE" ]; then
        vlicense LICENSE
    elif [ -f "${wrksrc}/LICENSE.txt" ]; then
        vlicense LICENSE.txt
    elif [ -f "${wrksrc}/COPYING.md" ]; then
        vlicense COPYING.md
    else
        # Если нет файла лицензии, создаём его из информации в исходниках
        msg_warn "No license file found, skipping...\n"
        # Можно также скопировать лицензию из описания пакета
        mkdir -p ${DESTDIR}/usr/share/licenses/${pkgname}
        echo "SPDX-License-Identifier: GPL-3.0-or-later" > \
            ${DESTDIR}/usr/share/licenses/${pkgname}/LICENSE
        echo "License: GPL-3.0-or-later" >> \
            ${DESTDIR}/usr/share/licenses/${pkgname}/LICENSE
        echo "Project: ${pkgname} version ${version}" >> \
            ${DESTDIR}/usr/share/licenses/${pkgname}/LICENSE
    fi
}
