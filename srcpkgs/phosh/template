# Template file for 'phosh'
pkgname=phosh
version=0.56.0
revision=1
wrksrc="${pkgname}-${version}"
build_style=meson
configure_args="
    -Dcompositor=phoc
    -Dphoc_tests=disabled
    -Dman=true
    -Db_lto=true
    -Dintrospection=false
    -Dgtk_doc=false"
hostmakedepends="
    meson
    pkg-config
    wayland-devel
    glib-devel
    gettext
    gtk+3
    python3-docutils
    qt6-declarative-tools
    "
makedepends="
    libcallaudio-devel
    elogind-devel
    evince-devel    
    evolution-data-server-devel
    feedbackd-devel
    gcr-devel
    glib-devel
    gmobile-devel
    gnome-bluetooth-devel
    gnome-desktop-devel
    gtk+3-devel
    libadwaita-devel
    libgudev-devel
    libhandy1-devel
    libsecret-devel
    pam-devel
    ModemManager-devel
    NetworkManager-devel
    polkit-devel
    pulseaudio-devel
    qrcodegen
    upower-devel
    wayland-protocols
    dbus-devel"
depends="
    phoc
    squeekboard
    gsettings-desktop-schemas
    elogind
    NetworkManager
    upower
    gnome-session
    gnome-settings-daemon
    dbus
    dbus-x11"
short_desc="Wayland shell for GNOME on mobile devices"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://gitlab.gnome.org/World/Phosh/phosh"
distfiles="https://sources.phosh.mobi/releases/phosh/phosh-${version}.tar.xz"
checksum="81b03db9574557e866943cb6bb233c22cb28e162809e58f83e0b4cbde41e11a0"

make_check=no

post_install() {
    vlicense COPYING
}

phosh-schemas_package() {
    short_desc="Phosh schemas"
    pkg_install() {
        vmove usr/share/glib-2.0/schemas
    }
}

phosh-plugins_package() {
    short_desc="Phosh plugins"
    pkg_install() {
        vmove usr/lib/phosh/plugins
    }
}

phosh-devel_package() {
    short_desc="Phosh development files"
    depends="phosh-${version}_${revision}"
    pkg_install() {
        if [ -d "${DESTDIR}/usr/include/phosh" ]; then
            vmove usr/include/phosh
        fi
        if [ -d "${DESTDIR}/usr/lib/pkgconfig" ]; then
            vmove usr/lib/pkgconfig
        fi    
        vmove "usr/lib/*.a" 2>/dev/null || true
        vmove "usr/lib/*.so" 2>/dev/null || true
        if [ -d "${DESTDIR}/usr/share/gir-1.0" ]; then
            vmove usr/share/gir-1.0
        fi
        if [ -d "${DESTDIR}/usr/share/vala" ]; then
            vmove usr/share/vala
        fi
        if [ -d "${DESTDIR}/usr/share/gtk-doc" ]; then
            vmove usr/share/gtk-doc
        fi
    }
}

