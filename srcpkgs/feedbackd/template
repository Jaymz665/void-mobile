# Template file for 'feedbackd'
pkgname=feedbackd
version=0.8.9
revision=1
wrksrc="${pkgname}-v${version}"
build_style=meson
configure_args="
    -Dtests=false
    -Dudev=true
    -Dintrospection=disabled 
    -Ddaemon=true
    -Dmedia-roles=true
    -Dvapi=false
    -Dgtk_doc=false"
hostmakedepends="
    pkg-config glib-devel vala gmobile meson"
makedepends="
    gsound-devel libgudev-devel json-glib-devel gmobile-devel
    elogind-devel eudev-libudev-devel"
short_desc="Daemon to provide haptic feedback on events"
maintainer="Jaymz665"
license="LGPL-3.0-or-later"
homepage="https://source.puri.sm/Librem5/feedbackd"
distfiles="https://gitlab.freedesktop.org/agx/feedbackd/-/archive/v${version}/feedbackd-v${version}.tar.gz"
checksum=046439dd165af6a79b989c2085863e25c7c7006be580cef937b32bf60b7aa53f

# Подпакеты как в Alpine
#subpackages="feedbackd-devel feedbackd-udev"

feedbackd_package() {
    short_desc+=" - daemon and library"
    pkg_install() {
        # Демон и утилиты
        vmove usr/libexec/feedbackd
        vmove usr/bin/feedbackd-cli
        vmove usr/bin/fbd-theme-validate
        # DBus
        vmove usr/share/dbus-1
        # Данные и темы
        vmove usr/share/feedbackd
        # Схемы
        vmove usr/share/glib-2.0/schemas
        # Библиотека и симлинк
        vmove "usr/lib*/libfeedback-*.so.*"
        vmove "usr/lib*/libfeedback-*.so" 
        # Udev
        vmove usr/lib/udev
        # Systemd сервисы (опционально)
        vmove usr/lib/systemd
    }
}

feedbackd-devel_package() {
    short_desc="Library for feedbackd - development files"
    depends="feedbackd>=${version}_${revision}"
    pkg_install() {
        # Заголовки
        vmove usr/include
        # pkgconfig
        vmove usr/lib/pkgconfig
        # Не забираем симлинк .so — он уже в основном пакете!
    }
}

post_install() {
    mkdir -p ${DESTDIR}/etc/sv/feedbackd
    cat > ${DESTDIR}/etc/sv/feedbackd/run <<'EOF'
#!/bin/sh
exec /usr/libexec/feedbackd 2>&1
EOF
    chmod +x ${DESTDIR}/etc/sv/feedbackd/run
    
    vlicense COPYING
}
