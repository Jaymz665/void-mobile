# Template file for 'sofia-sip-linphone'
pkgname=sofia-sip-linphone
version=1.13.45
revision=1
wrksrc="sofia-sip-${version}bc"
build_style=gnu-configure
configure_args="--with-openssl --enable-static=no --disable-rpath"
hostmakedepends="automake autoconf libtool m4 pkg-config"
makedepends="glib-devel openssl-devel lksctp-tools-devel"
short_desc="RFC3261 compliant SIP User-Agent library (Linphone version)"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="LGPL-2.1-only"
homepage="https://gitlab.linphone.org/BC/public/external/sofia-sip"
replaces="sofia-sip<0"
distfiles="https://github.com/BelledonneCommunications/sofia-sip/archive/${version}bc.tar.gz"
checksum="12b4a28a3de90d06ea24927f8266a16f84974a132ce2965e3d5bd02dbdde942d"

# torture_su_root test fails
make_check=no

pre_configure() {
	sh autogen.sh
}

post_install() {
	vlicense COPYING
}

sofia-sip-linphone-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}

sofia-sip-linphone-tools_package() {
	short_desc+=" - tools"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/bin
	}
}


