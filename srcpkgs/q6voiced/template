# Template file for 'q6voiced'
pkgname=q6voiced
version=0.2.1
revision=3
build_style=meson
hostmakedepends="pkg-config"
makedepends="alsa-lib-devel dbus-devel"
short_desc="Userspace QDSP6 voice driver daemon for oFono/ModemManager"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="MIT"
homepage="https://gitlab.postmarketos.org/postmarketOS/q6voiced"
distfiles="https://gitlab.postmarketos.org/postmarketOS/q6voiced/-/archive/${version}/q6voiced-${version}.tar.gz"
checksum="7e3b72edf40065d1348857b4e195cb2d05b466576d1ee42cf6ef1f05c2e46c3c"

post_install() {
	# Устанавливаем конфиг
	vinstall ${FILESDIR}/q6voiced.conf 644 etc/default q6voiced
	
	# Устанавливаем сервис
	vmkdir etc/sv/q6voiced
	vinstall ${FILESDIR}/q6voiced/run 755 etc/sv/q6voiced
}
