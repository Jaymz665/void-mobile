# Template file for 'calls'
pkgname=calls
version=50.0
revision=1
build_style=meson
configure_args="-Db_lto=true $(vopt_bool tests tests)"
hostmakedepends="desktop-file-utils gettext gobject-introspection	meson ninja python3-docutils	vala pkg-config glib-devel  gtk-update-icon-cache gtk4-update-icon-cache gobject-introspection"
makedepends="libcallaudio-devel evolution-data-server-devel feedbackd-devel folks-devel gmobile-devel gom-devel gsound-devel gstreamer1-devel gtk4-devel libadwaita-devel libpeas2-devel ModemManager-devel mobile-broadband-provider-info sofia-sip-linphone-devel"
depends="callaudiod ModemManager"

short_desc="Phone dialer and call handler"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://gitlab.gnome.org/GNOME/calls"
changelog="https://gitlab.gnome.org/GNOME/calls/-/raw/main/NEWS"
distfiles="${GNOME_SITE}/calls/${version%%.*}/calls-${version}.tar.xz"
checksum=f28ccc8e6fbc5079e7b8b5d11a551969bb70d905e5ed90d1b1d868f12045c72f

# XXX: Requires running Wayland compositor
make_check=no

build_options="tests"
build_options_default="no_tests"

if [ "$build_option_tests" ]; then
	# Additional dependencies for tests if needed
	:
fi

case "$XBPS_TARGET_MACHINE" in
	*-musl)
		configure_args+=" -Dintrospection=false"
		;;
esac

post_install() {
	vlicense COPYING
}


calls-lang_package() {
	short_desc+=" - translations"
	pkg_install() {
		vmove usr/share/locale
	}
}
