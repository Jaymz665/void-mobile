# Template file for 'feedbackd-udev'
pkgname=feedbackd-udev
version=0.8.9
revision=1
short_desc="Udev rules for feedbackd (OnePlus 6/6T)"
maintainer="Jaymz665 <your-email@example.com>"
license="LGPL-2.1-or-later"
homepage="https://source.puri.sm/Librem5/feedbackd"
archs="aarch64 armv7l x86_64 i686"

do_install() {
    # Создаем директорию для udev правил
    vmkdir usr/lib/udev/rules.d
    
    # Копируем наш файл правил
    cp ${FILESDIR}/72-feedbackd.rules ${DESTDIR}/usr/lib/udev/rules.d/
    chmod 644 ${DESTDIR}/usr/lib/udev/rules.d/72-feedbackd.rules
}

# Нет зависимостей от feedbackd
depends=""
