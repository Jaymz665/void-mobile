#!/bin/sh
# Хук для обновления EFI boot entry при установке нового ядра
# Аргументы: $1 = имя пакета, $2 = версия ядра

set -e

PKGNAME="$1"
KERNEL_VERSION="$2"
ESP_MOUNT="/boot/efi"
ESP_DEV="/dev/disk/by-partlabel/system_a"  # или /dev/sda13
BOOTAA64="${ESP_MOUNT}/EFI/BOOT/BOOTAA64.EFI"
KERNEL_SRC="/boot/vmlinux-${KERNEL_VERSION}-sdm845.efi"

echo ">>> void-uboot-hooks: Processing kernel ${KERNEL_VERSION} from package ${PKGNAME}"

# Проверка наличия нового ядра
if [ ! -f "${KERNEL_SRC}" ]; then
    echo "ERROR: EFI kernel not found at ${KERNEL_SRC}"
    # Пробуем альтернативный путь без -sdm845
    KERNEL_SRC="/boot/vmlinux-${KERNEL_VERSION}.efi"
    if [ ! -f "${KERNEL_SRC}" ]; then
        echo "ERROR: Also not found at ${KERNEL_SRC}"
        exit 1
    fi
fi

echo ">>> Found kernel at ${KERNEL_SRC}"

# Проверяем, смонтирован ли ESP
if ! mountpoint -q ${ESP_MOUNT}; then
    echo ">>> ESP not mounted at ${ESP_MOUNT}, mounting..."
    mkdir -p ${ESP_MOUNT}
    if [ -e "${ESP_DEV}" ]; then
        mount ${ESP_DEV} ${ESP_MOUNT} || {
            echo "ERROR: Failed to mount ESP at ${ESP_DEV}"
            exit 1
        }
        MOUNTED_BY_US=1
    else
        echo "ERROR: ESP device ${ESP_DEV} not found"
        exit 1
    fi
fi

# Копируем ядро в fallback
cp "${KERNEL_SRC}" "${BOOTAA64}"
chmod 644 "${BOOTAA64}" 2>/dev/null || true
echo ">>> Updated fallback boot entry at ${BOOTAA64}"

# Удаляем старую запись в efibootmgr (если есть)
EFI_DEVICE=$(efibootmgr -v 2>/dev/null | grep -B1 "Void Linux" | head -1 | cut -d' ' -f1 | sed 's/Boot//;s/*//')
if [ -n "$EFI_DEVICE" ]; then
    echo ">>> Removing old UEFI entry: Boot${EFI_DEVICE}"
    efibootmgr -b $EFI_DEVICE -B >/dev/null 2>&1 || true
fi

# Создаем новую запись в UEFI
echo ">>> Creating new UEFI boot entry..."
efibootmgr --create --label "Void Linux" \
    --loader /EFI/BOOT/BOOTAA64.EFI \
    --unicode "root=PARTLABEL=userdata rw console=ttyMSM0,115200n8 console=tty0 loglevel=4 quiet" >/dev/null 2>&1 || \
    echo "WARNING: Failed to create UEFI entry (non-critical)"

# Если мы сами смонтировали ESP, аккуратно отмонтируем
if [ -n "$MOUNTED_BY_US" ]; then
    echo ">>> Unmounting ESP..."
    umount ${ESP_MOUNT} || true
fi

echo ">>> void-uboot-hooks: Done"
exit 0
