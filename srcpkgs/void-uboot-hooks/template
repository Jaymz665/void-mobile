# Template file for 'void-uboot-hooks'
pkgname=void-uboot-hooks
version=0.2
revision=2
short_desc="U-Boot/EFI hooks for Void Linux on OnePlus 6T"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-2.0-only"
homepage="https://github.com/void-linux/void-packages"
archs="aarch64*"
depends="efibootmgr"

do_install() {
    # Создаём директорию для хуков
    vmkdir etc/kernel.d/post-install
    
    # Копируем хук из files/
    vinstall ${FILESDIR}/30-update-efistub 755 etc/kernel.d/post-install/
    
    # README с инструкцией
    vmkdir usr/share/doc/void-uboot-hooks
    cat > ${DESTDIR}/usr/share/doc/void-uboot-hooks/README << 'EOF'
Void Linux U-Boot/EFI Hooks for OnePlus 6T
===========================================

Этот пакет устанавливает хук для автоматического обновления EFI загрузчика
при обновлении ядра через xbps.

Установленные файлы:
------------------------
/etc/kernel.d/post-install/30-update-efistub
    Хук, который при обновлении ядра:
    - Монтирует ESP (если не смонтирован)
    - Копирует новое ядро в /boot/efi/EFI/BOOT/BOOTAA64.EFI
    - Обновляет запись в UEFI через efibootmgr

Требования:
------------------------
1. В /etc/fstab должна быть запись для ESP:
   UUID=AA74-1D05 /boot/efi vfat defaults 0 0

2. ESP должен быть отформатирован как FAT32
   (у вас уже есть: /dev/sda13 с меткой EFI)

3. Пакет efibootmgr должен быть установлен

Использование:
------------------------
После установки пакета хук будет работать автоматически
при каждом обновлении ядра. Никаких дополнительных действий
не требуется.

Для проверки:
  ls -la /etc/kernel.d/post-install/
  sudo efibootmgr -v | grep "Void"
EOF
}

void-uboot-hooks-doc_package() {
    short_desc+=" - documentation"
    pkg_install() {
        vmove usr/share/doc
    }
}
