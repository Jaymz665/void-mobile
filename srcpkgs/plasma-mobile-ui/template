do_install() {
	vinstall "${FILESDIR}/qtlogging.ini" 0644 etc/xdg/QtProject
	vinstall "${FILESDIR}/kscreenlockerrc" 0644 etc/xdg
	vinstall "${FILESDIR}/maliit-plasmamobile.json" 0644 usr/share/maliit/keyboard2/devices
	vinstall "${FILESDIR}/drkonqirc" 0644 etc/xdg
	vinstall "${FILESDIR}/gtk-app-wayland.sh" 0755 etc/profile.d
}

