# Template file for 'callaudiod'
pkgname=callaudiod
version=0.1.99
revision=1
build_style=meson
hostmakedepends="pkg-config glib-devel"
makedepends="alsa-lib-devel pulseaudio-devel AppStream-devel glib-devel"
short_desc="Call audio routing daemon"
maintainer="Jaymz665"
license="LGPL-3.0-or-later"
homepage="https://gitlab.com/mobian1/callaudiod"
distfiles="https://gitlab.com/mobian1/callaudiod/-/archive/${version}/callaudiod-${version}.tar.gz"
checksum=6b8214fb1fa08fa89012d8c85d671a61be37ad33373065daf7ae17bd703bd0ad

# Основной пакет: только демон и утилиты
callaudiod_package() {
	short_desc+=" - daemon and utilities"
	pkg_install() {
		vmove usr/bin
		vmove usr/share/dbus-1
		vmove usr/lib/systemd
		# Если есть man-страницы
		if [ -d "${PKGDESTDIR}/usr/share/man" ]; then
			vmove usr/share/man
		fi
	}
}

# Подпакет с библиотекой (libcallaudio)
libcallaudio_package() {
	short_desc="Library for call audio handling"
	depends="callaudiod>=${version}_${revision}"
	pkg_install() {
		# Устанавливаем только shared library
		vmove "usr/lib/*.so.*"
		# Документация библиотеки если есть
		if [ -d "${PKGDESTDIR}/usr/share/doc/libcallaudio" ]; then
			vmove usr/share/doc/libcallaudio
		fi
	}
}

# Подпакет для разработки (заголовки и .so для линковки)
libcallaudio-devel_package() {
	short_desc="Library for call audio handling - development files"
	depends="libcallaudio>=${version}_${revision} pkg-config"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"  # Симлинк для разработки
		# Vala bindings если есть
		if [ -d "${PKGDESTDIR}/usr/share/vala" ]; then
			vmove usr/share/vala
		fi
	}
}
